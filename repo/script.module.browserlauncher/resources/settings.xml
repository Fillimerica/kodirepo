<?xml version="1.0" ?>
<!-- CAUTION!! Any changes to this settings file must also be reflected in the guiSettings.py file. -->
<!-- Functionality to permit the RunScript to access the current settings values displayed in the UI. -->

<settings version="1">
	<section id="script.module.browserlauncher">
		<category id="general" label="30008" help="">
			<group id="1" label="30011">
				<!-- This Setting is used as a fingerprint internally by the get/set Setting routine and is not visible. Do not Remove -->
				<setting id="TopControlMarker" type="string" label="30000" help="">
					<level>0</level>
					<visible>false</visible>
					<default>TopControlSanityCheck</default>
					<control type="button" format="action">
					</control>
				</setting>
				<setting id="useIsolatedProfile" type="boolean" label="30062" help="30070">
					<level>0</level>
					<default>false</default>
					<control type="toggle"/>
				</setting>
				<setting id="ProfilePathOverride" type="boolean" label="30040" help="30071" parent="useIsolatedProfile">
					<level>0</level>
					<default>false</default>
					<dependencies>
						<dependency type="enable" setting="useIsolatedProfile">true</dependency>
					</dependencies>
					<control type="toggle"/>
				</setting>
				<setting id="ProfilePathCustom" type="path" label="30041" help="30072" parent="ProfilePathOverride">
					<level>0</level>
					<default>n/a</default>
					<constraints>
						<allowempty>true</allowempty>
					</constraints>
					<dependencies>
						<dependency type="enable" setting="ProfilePathOverride">true</dependency>
					</dependencies>
					<control type="button" format="path">
						<heading>30041</heading>
					</control>
				</setting>
			</group>
			<group id="2" label="30012">
				<setting id="Browser" label="30013" type="string" help="30076">
				<!-- This is the browser selection button. After selection it is updated to display -->
				<!-- the descriptive name of the browser to the user. -->
					<level>0</level>
					<default/>
					<constraints>
						<allowempty>true</allowempty>
					</constraints>
					<control type="button" format="action">
						<data>RunScript(script.module.browserlauncher,setting=Browser)</data>
					</control>
				</setting>
				<setting id="BrowserProfileButton" type="string" label="30050" help="">
					<level>0</level>
					<default>-not configured-</default>
					<control type="button" format="action">
						<data>RunScript(script.module.browserlauncher,setting=BrowserProfile)</data>
					</control>
				</setting>
<!-- The following settings are internal to the addon and are not visible to the user -->
<!-- They are managed by the script, and can be read by parent modules -->
				<setting id="BrowserFQFN" type="string" label="" help="">
				<!-- Holds the operating system path and name of the browser to execute. -->
					<level>0</level>
					<default>-not configured-</default>
					<visible>false</visible>
					<control type="edit" format="string">
					</control>
				</setting>
				<setting id="BrowserProfile" type="string" label="" help="">
					<level>0</level>
					<default>-not configured-</default>
					<visible>false</visible>
					<control type="edit" format="string">
					</control>
				</setting>
			</group>
		</category>
	</section>
</settings>

