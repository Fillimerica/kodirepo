<?xml version="1.0" ?>
<settings version="1">
	<section id="script.module.browserlauncher">
		<category id="general" label="30008" help="">
			<group id="1" label="">

                <setting id="winBrowser" type="integer" label="30013" help="">
                    <level>0</level>
	                <default>0</default>
                    <dependencies>
	                    <dependency type="visible" on="property" name="infobool">system.platform.windows</dependency>
                    </dependencies>
	                <constraints>
		                <options>
			                <option label="Chrome">0</option>
			                <option label="Firefox">1</option>
		                </options>
	                </constraints>
	                <control type="spinner" format="string"/>
                </setting>

                <setting id="useCustomPath" type="boolean" label="30010" help="">
	                <level>0</level>
	                <default>false</default>
                    <dependencies>
	                    <dependency type="visible" on="property" name="infobool">system.platform.windows</dependency>
                    </dependencies>
	                <control type="toggle"/>
                </setting>

                <setting id="customPath" type="path" label="30011" help="">
	                <level>0</level>
	                <default>special://home/addons/plugin.program.browser.launcher/script.sh</default>
                    <dependencies>
	                    <dependency type="visible" on="property" name="infobool">system.platform.windows</dependency>
                        <dependency type="enable" setting="useCustomPath">true</dependency>
                    </dependencies>
	                <constraints>
		                <writable>true</writable>
		                <allowempty>true</allowempty>
	                </constraints>
	                <control type="button" format="file">
		                <heading>30011</heading>
	                </control>
                </setting>

                <setting id="useOwnProfile" type="boolean" label="30012" help="">
	                <level>0</level>
	                <default>false</default>
                    <dependencies>
	                    <dependency type="visible" on="property" name="infobool">system.platform.windows</dependency>
                    </dependencies>
	                <control type="toggle"/>
                </setting>

                <setting id="androidBrowser" type="string" label="Browser ID" help="">
                    <level>0</level>
	                <default></default>
                    <dependencies>
	                    <dependency type="visible" on="property" name="infobool">system.platform.android</dependency>
                    </dependencies>
	                <constraints>
		                <allowempty>true</allowempty>
	                </constraints>
	                <control type="edit" format="string">
		                <heading>Browser ID</heading>
	                </control>
                </setting>

			</group>
		</category>
	</section>
</settings>

