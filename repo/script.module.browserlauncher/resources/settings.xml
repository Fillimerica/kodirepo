<?xml version="1.0" ?>
<settings version="1">
	<section id="script.module.browserlauncher">
		<category id="general" label="30008" help="">
			<group id="1" label="">
				<setting id="Browser" label="30013" type="string">
					<level>0</level>
					<default/>
					<constraints>
						<allowempty>true</allowempty>
					</constraints>
					<control type="button" format="action">
						<data>RunScript(script.module.browserlauncher,setting=Browser)</data>
					</control>
				</setting>
				<setting id="BrowserIndex" type="integer" label="30013" help="">
					<level>0</level>
					<default>-1</default>
					<visible>false</visible>
					<control type="edit" format="integer">
					</control>
				</setting>

                <setting id="useCustomPath" type="boolean" label="30010" help="">
	                <level>0</level>
	                <default>false</default>
                    <dependencies>
	                    <dependency type="visible" on="property" name="infobool">system.platform.windows</dependency>
                    </dependencies>
	                <control type="toggle"/>
                </setting>

                <setting id="customPath" type="path" label="30011" help="">
	                <level>0</level>
	                <default>special://home/addons/plugin.program.browser.launcher/script.sh</default>
                    <dependencies>
	                    <dependency type="visible" on="property" name="infobool">system.platform.windows</dependency>
                        <dependency type="enable" setting="useCustomPath">true</dependency>
                    </dependencies>
	                <constraints>
		                <writable>true</writable>
		                <allowempty>true</allowempty>
	                </constraints>
	                <control type="button" format="file">
		                <heading>30011</heading>
	                </control>
                </setting>

                <setting id="useOwnProfile" type="boolean" label="30012" help="">
	                <level>0</level>
	                <default>false</default>
                    <dependencies>
	                    <dependency type="visible" on="property" name="infobool">system.platform.windows</dependency>
                    </dependencies>
	                <control type="toggle"/>
                </setting>

			</group>
		</category>
	</section>
</settings>

