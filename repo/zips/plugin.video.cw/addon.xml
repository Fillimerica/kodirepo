<?xml version="1.0" encoding="UTF-8"?>
<addon id="plugin.video.cw" version="0.1.0" name="CW Network Plugin by TJF" provider-name="ThomasFilliman">
<requires>
  <import addon="xbmc.python" version="3.0.1"/>
  <import addon="script.module.web-pdb" version="1.0.0" optional="true"/>
  <import addon="script.module.selenium" version="3.14.0"/>
</requires>
<extension point="xbmc.python.pluginsource" library="main.py">
  <provides>video</provides>
</extension>
<extension point="xbmc.addon.metadata">
  <summary lang="en_GB">CW Network Video Plugin</summary>
  <description lang="en_GB">CW Network web scraper and video player launcher for Kodi.</description>
  <disclaimer lang="en_GB"></disclaimer>
  <license>GPL-3.0-only	</license>
  <platform>all</platform>
  <assets>
    <icon>resources/images/icon.png</icon>
    <fanart>resources/images/fanart.jpg</fanart>
    <screenshot>resources/images/screenshot-1.jpg</screenshot>
    <screenshot>resources/images/screenshot-2.jpg</screenshot>
  </assets>
  <news>
  [CR][B]0.1.0[/B]
  [CR]- Fixed episode listing error where non-season clips were being imported and causing a crash.
  [CR{- Implement optional debugging via web-pdb without code editing.
  [CR][B]0.0.1[/B]
  [CR]- Initial alpha release.</news>
</extension>
</addon>
